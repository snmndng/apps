# Production image for saleor/apps/apps/products-feed (Saleor Product Feed app).
#
# Built from the upstream saleor/apps monorepo (https://github.com/saleor/apps).
# The upstream repo ships devcontainer Dockerfiles only; this is the production
# image the LuxiorMall platform pins in infra/platform-version.yml.
#
# Build (from the repo root):
#   docker build -f Dockerfile.products-feed -t ghcr.io/snmndng/saleor-app-products-feed:3.3.7 .
#
# Runtime contract mirrors the app's own .env.example:
#   SECRET_KEY (required), REQUEST_SECRET (required), APL (file|dynamodb|upstash),
#   FILE_APL_PATH, ALLOWED_DOMAIN_PATTERN, APP_API_BASE_URL, APP_IFRAME_BASE_URL.
#
# The S3 bucket is OPTIONAL: the app can serve the XML feed itself from
# /api/feed/<url>/<channel>/google.xml. We serve it — that is the URL Google
# Merchant Center fetches, and it needs no bucket and no R2 credentials.

# ─── deps + build ───────────────────────────────────────────────────────────
FROM node:24-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=3072
ENV ENV=production
# The app validates its environment when it is imported, and Next.js imports it
# during the build — so SECRET_KEY must EXIST at build time or the build dies
# with "Validation error: Required at SECRET_KEY". This is a build-time
# placeholder only: the server reads the real secret from the runtime
# environment, and nothing build-time-derived depends on this value. It is
# never the production secret.
ENV SECRET_KEY=build-time-placeholder-not-used-at-runtime
# REQUEST_SECRET is required by the same schema, and it fails the build the
# same way ("Validation error: Required at REQUEST_SECRET"). It is the shared
# secret the feed's chunk-generation route checks against, so it is likewise
# resolved at runtime and never inlined.
ENV REQUEST_SECRET=build-time-placeholder-not-used-at-runtime
ENV SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
WORKDIR /app

# The whole workspace is copied so the pnpm workspace importers match
# pnpm-lock.yaml exactly; --frozen-lockfile fails otherwise. Only the
# products-feed app and its dependency packages are actually installed and built.
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter saleor-app-products-feed...
# Upstream does not set `output: "standalone"`; add it for a self-contained image.
RUN sed -i 's/^const nextConfig: NextConfig = {$/const nextConfig: NextConfig = {\n  output: "standalone",/' apps/products-feed/next.config.ts \
    && grep -q 'output: "standalone"' apps/products-feed/next.config.ts
# `--env-mode=loose` is REQUIRED, not a preference. turbo.json declares a
# strict `globalEnv` allowlist that does not include SECRET_KEY, and Turborepo's
# default strict mode STRIPS every env var that is not on that list before the
# task runs. Without this flag the build dies at "Collecting page data" with
# `Validation error: Required at "SECRET_KEY"` — the app's zod schema requires
# it, the compiler does not, and only the page-data worker imports the schema.
RUN pnpm turbo run build --filter=saleor-app-products-feed --env-mode=loose
# Standalone output for a pnpm monorepo keeps the workspace-relative layout,
# so the server entry is nested under apps/products-feed/.
RUN test -f apps/products-feed/.next/standalone/apps/products-feed/server.js
# The build-time placeholders must NOT have been inlined into the server
# bundle. Server-side `process.env.SECRET_KEY` and `process.env.REQUEST_SECRET`
# are resolved at runtime, so the real values come from the container's
# environment — but if a future Next.js release inlines them, the image would
# ship with a known key, and the app would encrypt Saleor's app metadata (and
# sign its feed requests) with it. Fail the build instead.
#
# The exit code is checked explicitly: grep returns 1 for "not found" (good),
# 0 for "found" (fatal) and 2+ for "could not scan" (also fatal). A plain
# `! grep ...` would pass on 2+ as well, and Alpine's busybox grep has no
# --include, so a filtered variant is not available either.
RUN set -e; \
    if grep -rq "build-time-placeholder-not-used-at-runtime" apps/products-feed/.next/standalone; then \
      echo "FATAL: a build-time secret placeholder was inlined into the server bundle"; \
      exit 1; \
    else \
      code=$?; \
      if [ "$code" -ne 1 ]; then \
        echo "FATAL: could not scan the bundle for the placeholder (grep exit $code)"; \
        exit 1; \
      fi; \
    fi

# ─── runtime ────────────────────────────────────────────────────────────────
FROM node:24-alpine AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# The port the app listens on INSIDE the container. It must match the port
# cloudflared proxies to (`http://products-feed-app:3007` in
# infra/cloudflared/config.yml) and the healthcheck below. Nothing publishes
# this port on the host — the tunnel is the only way in.
ENV PORT=3007
# Next.js standalone binds to $HOSTNAME. Docker sets that to the container id
# by default, so the server would listen on eth0 only and the container's own
# healthcheck would get ECONNREFUSED on loopback forever. (paystack-gateway
# image 0.1.0 had exactly this bug and reported `unhealthy` for its life.)
ENV HOSTNAME=0.0.0.0
WORKDIR /app
RUN addgroup -g 1001 -S app && adduser -u 1001 -S app -G app
COPY --from=build --chown=app:app /app/apps/products-feed/.next/standalone ./
COPY --from=build --chown=app:app /app/apps/products-feed/.next/static ./apps/products-feed/.next/static
COPY --from=build --chown=app:app /app/apps/products-feed/public ./apps/products-feed/public
# FileAPL writes the Saleor auth token here; mount a volume so a restart does
# not lose the installation.
RUN mkdir -p /app/.apl && chown -R app:app /app/.apl
USER app
EXPOSE 3007
# The app has no /api/health route; /api/manifest is its unauthenticated
# liveness endpoint and is what Saleor itself polls. The port is read from
# the environment rather than hardcoded, so it cannot drift from $PORT.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/manifest').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/products-feed/server.js"]
